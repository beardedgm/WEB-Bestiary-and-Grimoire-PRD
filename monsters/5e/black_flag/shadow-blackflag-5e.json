    {
      "name": "Strength Drain",
      "category": "action",
      "placement": "actions",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "_Melee Weapon Attack:_ +4 to hit, reach 5 ft., one creature. _Hit:_ 9 (2d6+2) necrotic damage, and the target's STR score is reduced by 1d4. The target dies if this reduces its STR to 0. Otherwise, the reduction lasts until the target finishes a short or long rest. If a Humanoid dies from this attack, a new shadow rises from the corpse 1d4 hours later."
      ],
      "damage": [
        {
          "formula": "2d6+2",
          "average": 9,
          "type": "necrotic"
        }
      ]
    },
    {
      "name": "Shadow Bond",
      "category": "action",
      "placement": "bonusActions",
      "activity": {
        "unit": "bonus",
        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "One creature the shadow can see within 5 feet of it must succeed on a DC 12 WIS save or the shadow bonds with the target's shadow for 1 minute. While bonded with the target's shadow, the shadow can use this bonus action to teleport to an unoccupied space within 5 feet of that creature, provided the creature is within 120 feet of the shadow."
      ]
    },
    {
      "name": "Shadow Stealth",
      "category": "action",
      "placement": "bonusActions",
      "activity": {
        "unit": "bonus",
        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "The shadow takes the Hide action. It can use this bonus action only while in dim light or darkness."
      ]
    }
