        "symbol": null
      },
      "traits": [],
      "entries": [
        "_Melee Weapon Attack:_ +6 to hit, reach 5 ft., one willing creature, or a creature that is grappled by the vampire, incapacitated, or restrained. _Hit:_ 8 (2d4+3) piercing damage plus 10 (3d6) necrotic damage. The target's HP maximum is reduced by an amount equal to the necrotic damage taken, and the vampire regains HP equal to that amount. The reduction lasts until the target finishes a long rest. The target dies if this effect reduces its HP maximum to 0."
      ],
      "damage": [
