      "traits": [],
      "entries": [
        "The mechanist cobbles together various machine parts it is carrying and creates a Tiny Construct. The Construct obeys the mechanist's spoken commands. It uses the statistics of a solodron but it isn't a mechadron or part of the Plan. The mechanist can have up to two such Constructs under its control at one time. Each Construct remains for 1 minute, until the mechanist dies, or until the mechanist uses this bonus action again to dismiss one or both of them."
      ],
      "recharge": {
        "kind": "d6-range",
        "min": 4,
        "max": 6,
        "display": "Recharge 4-6"
      }
    },
