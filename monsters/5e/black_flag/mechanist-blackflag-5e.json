      "placement": "reactions",
      "activity": {
        "unit": "reaction",
        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "When a creature the mechanist can see attacks it with a weapon made at least partially of metal while within 5 feet of it, the mechanist can release a magical, magnetic pulse. The attacker must succeed on a DC 13 DEX save or have disadvantage on the attack roll."
      ]
