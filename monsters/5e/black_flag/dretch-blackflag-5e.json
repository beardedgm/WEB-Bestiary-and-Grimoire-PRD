    {
      "name": "Abyssal Rejuvenation",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "Unlike other outsiders, a dretch that dies in its home plane of the Abyss is restored in a new body in 1d10 days, regaining all its HP and becoming active again. The new body appears in a random location in the Abyss. Only sprinkling holy water on the dretch's remains can prevent this trait from functioning."
      ]
    },
    {
      "name": "Demonic Resilience",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "The dretch is resistant to cold, fire, and lightning damage. In addition, it is immune to poison damage and to the poisoned condition."
      ]
    },
