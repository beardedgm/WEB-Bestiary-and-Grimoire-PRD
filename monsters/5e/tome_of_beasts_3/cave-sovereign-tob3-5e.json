      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "Its antennae shed dim light in a 5 ft. radius. Radius increases to 20' while at least one creature is incapacitated or stunned by Deathlights. At start of its turn if no creatures are incapacitated or stunned by Deathlights sovereign can suppress this light until start of its next turn."
      ],
      "condition": {
        "name": "incapacitated",
