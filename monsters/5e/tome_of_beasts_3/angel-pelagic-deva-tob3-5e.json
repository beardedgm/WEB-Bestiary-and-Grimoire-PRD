      "activity": {
        "unit": "bonus",
        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "Removes oxygen from nearby water for 1 min. Each creature that requires oxygen to live (including air-breathing creatures under effects of water breathing) and starts its turn within 20' of deva: DC 17 Con save or begin suffocating. Deva never suffers effects of this; can choose any creatures in area to ignore it."
      ],
