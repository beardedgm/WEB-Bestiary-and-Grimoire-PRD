  "entries": [
    {
      "name": "False Presence",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "The berstuc detects as a Fey when sensed by spells and features, such as the detect evil and good spell or a paladin's Divine Sense. However, it is still a Fiend and can be subjected to spells and features that affect Fiends, such as Divine Smite. Beasts and Plants find the berstuc's presence soothing and don't attack the berstuc unless ordered to or provoked."
      ]
    },
    {
      "name": "Forest Camouflage",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "The berstuc has advantage on Dexterity (Stealth) checks made to hide in forest terrain."
      ]
    },
    {
      "name": "Magic Resistance",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "The berstuc has advantage on saving throws against spells and other magical effects."
      ]
    },
    {
      "name": "Twisted Path",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "While in a nonmagical forest, the berstuc leaves no trail and can't be tracked, except by magical means. Creatures of the berstuc's choice within 30 feet of it that travel with it can't retrace their own trails, and become hopelessly lost after 1 hour of travel with the berstuc. Creatures led astray by the berstuc have disadvantage on ability checks to discern their location or to navigate for 24 hours."
      ]
    },
    {
      "name": "Verdant Nature",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "The berstuc doesn't require food or sleep."
      ]
    },
    {
      "name": "Multiattack",
      "category": "action",
      "placement": "actions",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "The berstuc makes three Slam attacks. If two Slam attacks hit a Medium or smaller creature, the berstuc can use Enclose on it."
      ]
    },
    {
      "name": "Slam",
      "category": "strike",
      "placement": "actions",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "Melee Weapon Attack: +10 to hit, reach 5 ft., one target. Hit: 19 (3d8 + 6) bludgeoning damage, and the target is grappled (escape DC 17) if it is a Large or smaller creature and the berstuc doesn't have two other creatures grappled."
      ],
      "attack": {
        "range": "melee",
