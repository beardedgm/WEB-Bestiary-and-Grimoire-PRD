      "category": "action",
      "placement": "bonusActions",
      "activity": {
        "unit": "bonus",
        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "Akyishigal magically transforms into a Large or smaller insectoid Beast or back into his true form, which is a Fiend. His statistics, other than his size, are the same in each form. Any equipment he is wearing or carrying transforms with him. He reverts to his true form if he dies."
      ]
    },
