      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "A creature that accepts a gift from the hag is magically cursed for 30 days. While it is cursed, the target automatically fails saving throws against the hags charm person, geas, and scrying spells, and the hag can cast control weather centered on the creature."
      ]
    },
