    {
      "name": "Fell Charm",
      "category": "action",
      "placement": "bonusActions",
      "activity": {
        "unit": "bonus",
        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "The cambion targets one creature within 30 feet. The target makes a DC 15 Wisdom saving throw. On a failure, it is magically charmed by the cambion for 1 day. The effect ends if the cambion or a cambions ally harms the target, or if the cambion commands it to take a suicidal action. While charmed, the target regards the cambion as a trusted friend and is an ally of the cambion. If the target makes a successful saving throw or the effect ends, the target is immune to this cambions Fell Charm for 24 hours."
      ],
      "save": {
        "defense": "wis",
        "dc": 15,
        "basic": false,
        "outcomes": {
          "success": "none",
          "failure": "full"
        }
      }
