  "entries": [
    {
      "name": "Chaos Mace",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "The uridimmu's attacks with its mace are magical. When the uridimmu hits with its mace, the mace deals an extra 4d8 fire, lightning, or radiant damage (included in the attack). The uridimmu chooses the type of damage when making the attack."
      ]
    },
    {
      "name": "Heroic Aura",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "Each friendly creature within 20 feet of the uridimmu can't be charmed or frightened. In addition, when a friendly creature within 20 feet of the uridimmu makes an attack roll or a saving throw, it can roll a d4 and add the result to the attack roll or saving throw. The uridimmu's aura doesn't work in the area of an antimagic field spell or while in a temple, shrine, or other structure dedicated to a chaotic deity."
      ],
      "condition": {
        "name": "charmed",
        "duration": null,
        "repeatSave": null
      }
    },
    {
      "name": "Magic Resistance",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "The uridimmu has advantage on saving throws against spells and other magical effects."
      ]
    },
    {
      "name": "Innate Spellcasting",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
