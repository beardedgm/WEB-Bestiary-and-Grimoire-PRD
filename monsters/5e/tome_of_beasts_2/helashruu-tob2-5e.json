        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "The helashruu magically teleports, along with any equipment it is wearing or carrying, up to 120 feet to an unoccupied space it can see."
      ]
    },
    {
      "name": "Dimensional Hop",
      "category": "action",
      "placement": "actions",
      "activity": {
        "unit": "action",
