      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "When the silenal is within 5 feet of an alcoholic beverage, it has truesight out to a range of 90 feet. In addition, it notices secret doors hidden by magic within 30 feet of it."
      ]
