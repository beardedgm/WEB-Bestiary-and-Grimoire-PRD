    {
      "name": "Incorporeal Movement",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "The de ogen can move through other creatures and objects as if they were difficult terrain. It takes 5 (1d10) force damage if it ends its turn inside an object."
      ],
      "damage": [
        {
          "formula": "1d10",
