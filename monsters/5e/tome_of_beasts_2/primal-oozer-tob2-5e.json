  "entries": [
    {
      "name": "Acidic Slime",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "A creature that touches the primal oozer or hits it with a melee attack while within 5 feet of it takes 3 (1d6) acid damage."
      ],
      "damage": [
        {
          "formula": "1d6",
          "average": 3,
