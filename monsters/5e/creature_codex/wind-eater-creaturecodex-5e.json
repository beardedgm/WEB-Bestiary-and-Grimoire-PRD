      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "As a bonus action while in dim light or darkness, the wind eater becomes invisible. The invisibility lasts until the wind eater uses a bonus action to end it or until the wind eater attacks, is in bright light, or is incapacitated. Any equipment the wind eater wears or carries is invisible with it."
      ],
      "condition": {
        "name": "incapacitated",
        "duration": null,
        "repeatSave": null
      }
    },
