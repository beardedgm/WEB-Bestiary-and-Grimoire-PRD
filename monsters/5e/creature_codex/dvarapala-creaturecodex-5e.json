      "activity": null,
      "traits": [],
      "entries": [
        "The dvarapala can make an opportunity attack when a hostile creature moves within its reach as well as when a hostile creature moves out of its reach. It gets one extra reaction that be used only for opportunity attacks."
      ]
    },
