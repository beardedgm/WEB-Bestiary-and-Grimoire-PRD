      "name": "None May Stop Death",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "When a creature within 30 feet of a dark father regains hp through any means other than resting, it must succeed on a DC 14 Constitution saving throw or take 3 (1d6) necrotic damage and have disadvantage on its next death saving throw."
