    {
      "name": "Starving Wrath",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "If an alnaar hasn't fed on a Medium-sized or larger creature within the last 12 hours, it is starving. While starving, the alnaar's Armor Class is reduced by 2, it has advantage on melee attack rolls against any creature that doesn't have all of its hp, and will direct its attacks at a single foe regardless of tactical consequences. Once it feeds on a Medium-sized or larger corpse or brings a Medium-sized or larger creature to 0 hp, it is no longer starving."
      ]
    },
