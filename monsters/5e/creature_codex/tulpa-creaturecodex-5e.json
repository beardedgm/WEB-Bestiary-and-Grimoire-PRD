    {
      "name": "Rise Again",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "Within a day of being slain, the tulpa reforms within 500 feet of its creator. It doesn't reform if its creator is slain, or if the creator's mental disturbance is healed. The tulpa is immune to all damage dealt to it by its creator."
      ]
    },
    {
      "name": "It Follows",
