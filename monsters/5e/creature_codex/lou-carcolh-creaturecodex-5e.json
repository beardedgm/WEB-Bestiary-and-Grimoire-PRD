    {
      "name": "Sticky Tongues",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "Given half an hour, the lou carcolh can extend its 6 sticky tongues up to 60 feet from itself. A creature who touches one of these tongues must succeed on a DC 13 Dexterity saving throw or be restrained as it adheres to the tongue. The tongues can be attacked (AC 12, 10 hp), and any damage done to a tongue is also done to the lou carcolh. Killing a tongue ends the restrained condition, and the lou carcolh can't use that tongue for for the next 24."
      ],
      "save": {
        "defense": "dex",
        "dc": 13,
        "basic": false,
        "outcomes": {
          "success": "none",
          "failure": "full"
        }
      },
      "condition": {
        "name": "restrained",
        "duration": null,
        "repeatSave": null
      }
    },
