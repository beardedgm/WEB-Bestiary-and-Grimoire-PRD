    {
      "name": "Limited Telepathy",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "Using telepathy, a hallowed reed can magically communicate with any other good-aligned creature within 100 feet of it. This communication is primarily through images and emotions rather than actual words."
      ]
    },
    {
      "name": "Rebirth",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "If a hallowed reed is slain, a new patch of hallowed reeds will grow in the same spot starting within a week of its death. Charring or salting the ground where a hallowed reed was slain prevents this resurgence."
      ]
    },
    {
