    {
      "name": "Absorbent",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "When the avatar damages a creature, it absorbs a portion of that creature's knowledge and power. As a bonus action, it can recreate any action available to a creature it damaged within the last minute. This includes spells and actions with limited uses or with a recharge. This recreated action is resolved using the avatar's statistics where applicable."
      ]
    },
    {
      "name": "Amorphous",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "The avatar, including its equipment, can move through a space as narrow as 1 inch wide without squeezing."
      ]
    },
    {
      "name": "Legendary Resistance",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "If the avatar fails a saving throw, it can choose to succeed instead."
      ],
      "uses": {
        "count": 3,
        "period": "day",
        "display": "3/Day"
      }
    },
    {
