      "name": "Voracious Greed",
      "category": "action",
      "placement": "actions",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "The gilded devil magically consumes up to 1 cubic foot of nonmagical jewelry or coins made of precious material within 5 feet of it. It regains 5 hp for every 200 gp of the consumed objects' value. If the jewelry or coins are being worn or carried by a creature, that creature must succeed on a DC 15 Dexterity saving throw to prevent the consumption."
      ],
      "save": {
        "defense": "dex",
        "dc": 15,
        "basic": false,
        "outcomes": {
          "success": "none",
          "failure": "full"
        }
