    {
      "name": "Create Specter",
      "category": "action",
      "placement": "actions",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "The deathwisp targets a Humanoid within 10 feet of it that has been dead for no longer than 1 minute and died violently. The target's spirit rises as a specter in the space of its corpse or in the nearest unoccupied space. This specter is under the deathwisp's control. The deathwisp can have no more than twelve specters under its control at one time."
      ]
    },
