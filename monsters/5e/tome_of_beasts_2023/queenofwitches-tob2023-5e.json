    {
      "name": "Spray of Moonlight",
      "category": "action",
      "placement": "actions",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "The Queen of Witches sends moonlight flooding out from her. Each creature within 15 feet of her must make a DC 20 Dexterity saving throw, taking 42 (12d6) radiant damage on a failed save, or half as much damage on a successful one. If the Queen is standing in an area of moonlight when she uses this action, each creature in the area has disadvantage on the saving throw. A creature that fails the saving throw by 5 or more is blinded until the end of its next turn."
      ],
      "recharge": {
        "kind": "d6-range",
        "min": 5,
        "max": 6,
        "display": "Recharge 5-6"
      },
      "damage": [
        {
          "formula": "12d6",
          "average": 42,
          "type": "radiant"
        }
      ],
      "save": {
        "defense": "dex",
        "dc": 20,
        "basic": false,
        "outcomes": {
          "success": "half",
          "failure": "full"
        }
      },
      "condition": {
        "name": "blinded",
        "duration": null,
        "repeatSave": null
