  "entries": [
    {
      "name": "Alluring Presence",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "When a Humanoid that can see the lorelei starts its turn within 30 feet of the lorelei, the lorelei can force it to make a DC 15 Wisdom saving throw if the lorelei isn't incapacitated and can see the Humanoid. On a failed save, the Humanoid is charmed until the start if its next turn. While charmed, the target is incapacitated and must move on its turn toward the lorelei by the most direct route, trying to get within 5 feet of the lorelei for a kiss from her. The Humanoid doesn't avoid opportunity attacks, but before moving into damaging terrain, such as lava or a pit, and whenever it takes damage, the Humanoid can repeat the saving throw. If the saving throw is successful, the effect ends for it, and it regains its senses for the remainder of its turn."
      ],
      "save": {
        "defense": "wis",
        "dc": 15,
        "basic": false,
        "outcomes": {
          "success": "none",
          "failure": "full"
        }
      },
      "condition": {
        "name": "charmed",
        "duration": null,
        "repeatSave": null
      }
    },
    {
