      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "The lorelei can breathe air and water."
      ]
    },
    {
      "name": "Free Water Spirit",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
