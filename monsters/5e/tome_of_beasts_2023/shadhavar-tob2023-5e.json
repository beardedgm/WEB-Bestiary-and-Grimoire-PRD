        "count": 1,
        "period": "day",
        "display": "1/Day"
      },
      "area": {
        "shape": "sphere",
        "size": 15,
        "unit": "ft"
      }
    },
    {
      "name": "Plaintive Melody",
      "category": "action",
      "placement": "bonusActions",
      "activity": {
        "unit": "bonus",
        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "The shadhavar plays a captivating melody through its hollow horn. Each creature within 60 feet of the shadhavar that can hear it must succeed on a DC 13 Wisdom saving throw or be charmed until the start of the shadhavar's next turn. While charmed, a creature is incapacitated, its speed is reduced to 0, and the shadhavar has advantage on attack rolls against it."
      ],
