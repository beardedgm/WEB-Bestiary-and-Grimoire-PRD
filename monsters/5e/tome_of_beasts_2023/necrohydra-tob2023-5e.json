  "entries": [
    {
      "name": "Multiple Heads",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "The necrohydra has five fleshy heads. While it has more than one head, the necrohydra has advantage on saving throws against being blinded, charmed, deafened, frightened, stunned, and knocked unconscious. Whenever the necrohydra takes 25 or more damage in a single turn, one of its fleshy heads dies. If all its fleshy heads die, the necrohydra can't use Unnerving Faces and can't use or maintain Dreadful Dirge."
      ]
    },
    {
      "name": "Reactive Heads",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "For each head the necrohydra has beyond one, it gets an extra reaction that can be used only for opportunity attacks."
      ]
    },
    {
      "name": "Undead Nature",
      "category": "passive",
      "placement": "traits",
