        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "Melee or Ranged Spell Attack: +9 to hit, reach 5 ft. or range 120 ft., one target. Hit: 12 (2d6 + 5) fire damage plus 9 (2d8) poison damage."
