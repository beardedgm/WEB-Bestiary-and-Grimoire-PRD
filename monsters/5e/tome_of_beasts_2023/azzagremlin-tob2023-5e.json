  "entries": [
    {
      "name": "Contagious Lightning",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "A creature that touches the azza gremlin or hits it with a metal weapon while within 5 feet of it receives a discharge of lightning. The creature must succeed on a DC 10 Constitution saving throw or attract lightning for 1 minute. For the duration, attacks that deal lightning damage have advantage against the affected creature, the creature has disadvantage on saving throws against spells and effects that deal lightning damage, and if the creature takes lightning damage, it is paralyzed until the end of its next turn. An affected creature can repeat the saving throw at the end of each of its turns, ending the effect on itself on a success."
      ],
      "save": {
        "defense": "con",
        "dc": 10,
        "basic": false,
        "outcomes": {
          "success": "none",
          "failure": "full"
        }
      },
      "condition": {
        "name": "paralyzed",
        "duration": "1 minute",
        "repeatSave": null
      }
    },
