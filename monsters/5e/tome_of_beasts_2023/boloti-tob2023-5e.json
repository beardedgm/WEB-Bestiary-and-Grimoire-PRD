        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "One creature in the boloti's space must make a DC 12 Strength saving throw. On a failure, the target takes 9 (2d8) bludgeoning damage, and if it is Medium or smaller, it is grappled (escape DC 12). Until this grapple ends, the target is restrained and unable to breathe unless it can breathe water. If the saving throw is successful, the target takes half the damage and is pushed out of the boloti's space."
      ],
      "damage": [
        {
          "formula": "2d8",
          "average": 9,
          "type": "bludgeoning"
        }
      ],
