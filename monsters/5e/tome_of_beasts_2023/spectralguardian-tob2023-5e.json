    {
      "name": "Disgrace Bound",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "The spectral guardian is bound to a tomb, castle ruins, or other place related to the disgrace in life that caused it to rise as a spectral guardian in death. If the guardian starts its turn more than 1 mile from its bound location, it loses its Spectral Blade action until it returns to the region. If it remains outside the region, it automatically teleports back to its bound location after 24 hours, regardless of distance."
      ]
    },
    {
      "name": "Incorporeal Movement",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "The spectral guardian can move through other creatures and objects as if they were difficult terrain. It takes 5 (1d10) force damage if it ends its turn inside an object."
      ],
