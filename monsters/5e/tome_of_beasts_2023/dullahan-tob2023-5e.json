    {
      "name": "Baleful Glare",
      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "When a creature that can see the eyes of the dullahan's severed head starts its turn within 30 feet of the dullahan, the dullahan can force it to make a DC 17 Wisdom saving throw if the dullahan isn't incapacitated and can see the creature. On a failed save, the creature is frightened until the start of its next turn. While frightened in this way, the creature must take the Dash action and move away from the dullahan by the safest available route. A doomed creature that fails this saving throw is restrained while frightened instead."
      ],
      "save": {
        "defense": "wis",
