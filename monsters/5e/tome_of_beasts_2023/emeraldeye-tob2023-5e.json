      "category": "passive",
      "placement": "traits",
      "activity": null,
      "traits": [],
      "entries": [
        "The emerald eye must be psychically bound to a creature to survive. It loses 5 (2d4) hp for every hour it is not bound to a creature or every hour it is more than 30 feet away from its bound creature."
      ]
    },
    {
      "name": "Phrenic Burst",
      "category": "strike",
      "placement": "actions",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": null
      },
      "traits": [],
      "entries": [
        "Melee or Ranged Spell Attack: +5 to hit, range 60 ft., one creature. Hit: 10 (2d6 + 3) psychic damage."
      ],
      "attack": {
        "range": "melee",
        "subtype": "spell",
        "bonus": 5,
        "map": [
          5
        ],
        "traits": [],
        "targets": "one creature",
