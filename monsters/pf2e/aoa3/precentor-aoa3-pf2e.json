    {
      "name": "Assemble Choir",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 2,
        "symbol": "◆◆"
      },
      "traits": [],
      "entries": [
        "The precentor adds a creature that is affected by its Tormenting Touch and is within 100 feet to its choir of screams. A precentor can have any number of creatures in its choir, although a creature no longer affected by Tormenting Touch leaves the choir immediately. Creatures in a precentor's choir of screams are fascinated by each other and the precentor, and they can't use hostile actions toward each other or the precentor. When the precentor casts an innate divine spell, it can cause the effect to originate from any member of its choir instead of itself, using the precentor's saving throw DC and attack bonus."
      ]
    },
    {
      "name": "Focus Gaze",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [
        "concentrate",
        "divine",
        "enchantment",
        "mental",
        "visual"
      ],
      "entries": [
        "The precentor stares at a creature they can see within 30 feet. The target must immediately attempt a Will save against feel the blades. After attempting this save, the creature is then temporarily immune until the start of the precentor's next turn. In addition, if the creature was already doomed, on a failed save it sees the skin of its own body peel back, making it confused for as long as it remains doomed."
      ]
    },
    {
      "name": "Tormenting Touch",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [
        "divine",
        "emotion",
        "enchantment",
        "mental"
      ],
      "entries": [
        "The precentor touches a creature within 10 feet, causing it to constantly scream in agony. The target must attempt a DC 38 Will save. While the target is stupefied by this effect, its continual screams cause it to automatically fail Stealth checks."
      ],
      "save": {
        "defense": "will",
        "dc": 38,
        "basic": false,
        "outcomes": {
          "criticalSuccess": "The target is unaffected.",
          "success": "The target is stupefied|CRB|stupefied 1.",
          "failure": "The target is stupefied|CRB|stupefied 3.",
          "criticalFailure": "The target is stupefied|CRB|stupefied 4. The target can attempt a new Will save at the start of each of its turns, reducing the stupefied condition by 1 on each successful save. If the target reduces its stupefied condition to 0 in this way, the target is no longer affected."
        }
      }
    }
