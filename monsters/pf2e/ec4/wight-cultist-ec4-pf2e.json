    {
      "name": "Wight Spawn",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [
        "divine",
        "necromancy"
      ],
      "entries": [
        "A living humanoid slain by a wight's claw or ranseur Strike rises as a wight after 1d4 rounds. This wight spawn is under the command of the wight that killed it. It doesn't have drain life or wight spawn and becomes clumsy|CRB|clumsy 2 for as long as it is a wight spawn. If the creator of the wight spawn dies, the wight spawn becomes a full-fledged, autonomous wight; it regains its free will, gains drain life and wight spawn, and is no longer clumsy."
      ]
    }
