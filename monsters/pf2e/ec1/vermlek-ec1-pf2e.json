    {
      "name": "Abandon Body",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 2,
        "symbol": "◆◆"
      },
      "traits": [
        "manipulate"
      ],
      "entries": [
        "The worm demon crawls out of the body it is inhabiting, devouring much of the body's remaining flesh and regaining 10 Hit Points in the process. The corpse it leaves behind is little more than a husk."
      ],
      "requirements": "The worm demon is Inhabiting a Body"
    },
    {
      "name": "Inhabit Body",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 3,
        "symbol": "◆◆◆"
      },
      "traits": [
        "manipulate"
      ],
      "entries": [
        "The worm demon crawls into the body of an adjacent dead Medium humanoid, consuming the bulk of the victim's skeleton and internal organs as it does so and cramming itself into the cavity. As long as it Inhabits a Body, the worm demon loses its bite attack, can wield weapons like a humanoid, gains a +3 circumstance bonus to AC, and gains a +3 circumstance bonus to Deception checks to Impersonate the creature it is inhabiting. It cannot use this ability if it is already Inhabiting a Body."
      ]
    },
    {
      "name": "Unsettling Movement",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [
        "emotion",
        "fear",
        "mental",
        "visual"
      ],
      "entries": [
        "Whenever the vermlek Abandons a Body or Inhabits a Body, all creatures within 30 feet who can see the vermlek must succeed at a DC 19 Will save or become frightened|CRB|frightened 1. On a critical failure, the creature is frightened|CRB|frightened 1 and sickened|CRB|sickened 1. Regardless of the result, creatures are immune to the same vermlek's unsettling movement for 24 hours."
      ],
