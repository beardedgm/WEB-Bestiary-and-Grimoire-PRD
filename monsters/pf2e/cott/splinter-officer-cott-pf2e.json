    {
      "name": "Rally the Rabble",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 3,
        "symbol": "◆◆◆"
      },
      "traits": [
        "concentrate",
        "divine"
      ],
      "entries": [
        "The splinter officer mentally energizes the undead under its command. Each undead that shares the officer's splintered soul is quickened|PC1 for 1 round. Quickened|PC1 allies can use the extra action only to Stride|PC1 or Strike|PC1. The officer can't Rally the Rabble again for 1d4 rounds."
      ]
    },
    {
      "name": "Synchronized Step",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 2,
        "symbol": "◆◆"
      },
      "traits": [
        "concentrate",
        "divine"
      ],
      "entries": [
        "The splinter officer mentally commands the undead that share its splintered soul to reposition. The officer Step|PC1|Steps, and each undead that shares the officer's splintered soul can use a reaction to Step|PC1."
      ]
