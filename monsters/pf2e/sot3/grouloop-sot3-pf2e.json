      },
      "traits": [
        "sonic"
      ],
      "entries": [
        "Grouloop utters a powerful croak that deals 6d10 sonic damage to any non-boggard within a 30-foot emanation (DC 27 basic Fortitude save). A creature with the frightened condition that fails its saving throw increases its frightened condition by 1 (on a critical failure, the creature is also fleeing for as long as it is frightened). Grouloop can't use Soul-Shaking Croak again for 1d4 rounds."
      ],
      "area": {
        "shape": "emanation",
