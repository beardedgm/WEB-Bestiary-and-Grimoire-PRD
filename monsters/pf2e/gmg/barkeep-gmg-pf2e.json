    {
      "name": "Bar Brawler",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [],
      "entries": [
        "The barkeep has been in enough bar fights to know how to throw a few punches. When fighting in their bar and making a nonlethal attack, the barkeep gains a +1 circumstance bonus to attack rolls and deals an additional 1d4 damage."
      ]
    },
    {
      "name": "Barkeep's Advice",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 3,
        "symbol": "◆◆◆"
      },
      "traits": [
        "auditory",
        "fortune",
        "linguistic",
        "mental"
      ],
      "entries": [
        "The barkeep gives some pertinent advice to a single creature other than themself. For 24 hours, when that creature fails a skill check or saving throw, they can recall this advice and reroll the check, using the second result instead. Once that creature uses this ability, its effect ends. A creature that receives the Barkeep's Advice is temporarily immune to the ability for 1 month."
      ],
      "frequency": {
        "number": 1,
        "unit": "day",
        "text": null
      }
