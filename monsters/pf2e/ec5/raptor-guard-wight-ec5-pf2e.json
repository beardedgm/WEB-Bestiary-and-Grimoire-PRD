    {
      "name": "Hungry Spear",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [
        "divine",
        "necromancy"
      ],
      "entries": [
        "The Raptor Guard wight's ranged spear Strikes apply drain life, but the wight doesn't gain any temporary Hit Points if the attack hits."
      ]
    },
    {
      "name": "Terror Master",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [],
      "entries": [
        "As long as the Raptor Guard wears its dinosaur-skull helm, its Strikes deal an additional 1d10 negative damage, or an additional 2d10 damage to frightened creatures."
      ],
      "damage": [
        {
          "formula": "1d10",
