    {
      "name": "Necromatic Winding",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [
        "manipulate",
        "necromancy"
      ],
      "entries": [
        "Parsus winds up their necromechanical innovation. They choose an active effect with the necromancy trait that originated from one of their spells or abilities (such as Clockwork Necromancy). The effect's duration extends to the end of Parsus's next turn."
      ]
    },
    {
      "name": "Necromechanical Innovation",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [],
      "entries": [
        "Although a necromancer by training, Parsus recently developed a complex device called a necromechanical innovation. This device allows Parsus to use their Clockwork Necromancy, Explode|G&G, and Necromatic Winding abilities. It otherwise functions as an inventor weapon innovation (Guns & Gears 18) with no modifications."
      ]
    }
