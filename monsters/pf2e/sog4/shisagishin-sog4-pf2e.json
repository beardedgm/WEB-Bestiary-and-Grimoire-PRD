      "traits": [],
      "entries": [
        "The shisagishin causes the flesh of any number of creatures grabbed or restrained by it to swiftly begin to decay. Each of those creatures must attempt a DC 32 Fortitude save."
      ],
      "save": {
        "defense": "fortitude",
        "dc": 32,
