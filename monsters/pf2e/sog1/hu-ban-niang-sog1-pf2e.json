        "emotion",
        "fear",
        "mental"
      ],
      "entries": [
        "Granny Hu threatens to expose a secret of the triggering creature. She attempts an Intimidation check against the triggering creature's Will DC. Her reputation means she can threaten a PC even if she doesn't actually know a secret, but if she does know an especially dangerous or shameful one, she gains a +2 circumstance bonus to her Intimidation check."
      ],
      "trigger": "A creature within 30 feet attempts to Coerce or Demoralize a creature",
      "save": {
        "defense": null,
        "dc": null,
        "basic": false,
        "outcomes": {
          "criticalSuccess": "The creature is frightened 2, and the result of their Coerce or Demoralize attempt is reduced by one degree of success.",
