    {
      "name": "Inhabit Vessel",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 2,
        "symbol": "◆◆"
      },
      "traits": [
        "manipulate"
      ],
      "entries": [
        "The spider touches and melds with its bonded vessel, bringing it to life. It can cease Inhabiting its Vessel by spending a single action, which has the concentrate trait. While Inhabiting the Vessel, it loses its fly Speed and gains Immunities healing, nonlethal; Resistances physical 6 (except bludgeoning); Speed 25 feet, climb 25 feet; and the following Strike. - Melee 1 stone fangs 14 (finesse), Damage 2d8+7 piercing"
      ]
    },
    {
      "name": "Spirit Body",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [],
      "entries": [
        "When not Inhabiting its Vessel, the stone spider is incorporeal and gains resistance 6 to all damage (except force damage and ghost touch; double resistance against non-magical)."
      ]
    },
    {
      "name": "Spirit Web Trap",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [
        "force"
      ],
      "entries": [
        "A creature hit by the stone spider's web attack is immobilized and stuck to the nearest surface until it Escapes (DC 22)."
      ]
