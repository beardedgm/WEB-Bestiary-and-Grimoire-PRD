      "entries": [
        "The seamer makes a war razor Strike against the same creature that they just damaged. On a hit, the seamer slices a strip of flesh from the target and deals 1d6 persistent bleed damage in addition to the war razor's usual damage."
      ],
      "requirements": "The Skinsaw seamer dealt damage with a melee weapon other than its war razor with their last action"
    },
    {
      "name": "Quick Stitch",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 2,
        "symbol": "◆◆"
      },
      "traits": [],
      "entries": [
        "The seamer stitches a piece of cloth to the creature's arm, face, or leg, potentially hindering it. The creature must attempt a DC 26 Reflex saving throw; if the seamer has already successfully used their Flay ability against the creature within the past minute, the creature's save result is one degree of success worse."
      ],
      "requirements": "The Skinsaw seamer is currently grappling a creature",
      "save": {
        "defense": "reflex",
        "dc": 26,
        "basic": false,
        "outcomes": {
          "criticalSuccess": "The creature is unaffected.",
          "success": "The creature takes 1d4 piercing damage.",
          "failure": "The creature is clumsy|CRB|clumsy 1, dazzled, enfeebled|CRB|enfeebled 1, or flat-footed (seamer's choice). This effect lasts until the creature spends a single action to tear out the stitching, which deals 1d6 piercing damage to it.",
          "criticalFailure": "The creature is clumsy|CRB|clumsy 2, blinded, enfeebled|CRB|enfeebled 2, or flat-footed (seamer's choice). This effect lasts until the creature spends 2 actions to tear out the stitching, which deals 2d6 piercing damage to it."
        }
