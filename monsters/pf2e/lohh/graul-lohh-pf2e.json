    {
      "name": "Seize",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [],
      "entries": [
        "The graul pulls the creature toward itself. The graul attempts an Athletics check against the creature's Fortitude DC. With a success, the graul pulls the creature 15 feet closer to it."
      ],
      "requirements": "The graul has a creature grabbed with its tentacle"
    },
    {
      "name": "Sound Mimicry",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [],
      "entries": [
        "The graul can perfectly imitate the sounds and speech of other creatures by attempting a Deception check against a listener's Will DC. The graul doesn't need to understand the language it's mimicking, but when speaking a language it doesn't know, the creature can only repeat specific words and phrases it has heard in the past 24 hours. The graul can't use this ability to duplicate voice-based abilities or spells."
      ]
    },
    {
      "name": "Tentacle Grab",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [],
      "entries": [
        "A creature hit by the graul's tentacle becomes grabbed by the graul. The creature isn't immobilized, but it can't move beyond the reach of the graul's tentacle. A creature can sever the tentacle with a Strike against AC 18 that deals at least 10 slashing damage. This deals no damage to the graul but prevents it from using its tentacle Strike until it regrows the tentacle, which takes 1 round. The graul can move without ending the Grab as long as the creature remains within the tentacle's reach."
      ]
    }
