      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [
        "divine",
        "evocation",
        "visual"
      ],
      "entries": [
        "When a ghaele fixes their gaze upon a non-good creature, the creature is subjected to the effects of divine decree (DC 38 Will save). If it survives, the creature is temporarily immune to Ghaele's Gaze for 1 minute."
