      ],
      "entries": [
        "30 feet. A susurrus of distracting whispers and dilations in reality surround a hegessik. When a non-protean ends its turn in the aura, it must attempt a DC 33 Will save. If it fails, it becomes confused for 1 round."
      ],
      "save": {
        "defense": "will",
        "dc": 33,
        "basic": false,
        "outcomes": {}
