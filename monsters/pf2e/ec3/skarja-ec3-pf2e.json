      "entries": [
        "Skarja can take on the appearance of any Medium female humanoid. This doesn't change her Speed or her attack or damage bonuses with her Strikes, but might change the damage type her Strikes deal (typically to bludgeoning)."
      ]
    },
    {
      "name": "Dream Haunting",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [
        "enchantment",
        "occult",
        "mental"
      ],
      "entries": [
        "If Skarja is ethereal and hovering over a sleeping chaotic or evil creature, she can ride the victim's back until dawn. The creature endures tormenting dreams as Skarja casts nightmare on it, and is exposed to Abyssal plague. Any drained condition caused by dream haunting is cumulative. Only an ethereal being can confront the night hag and stop her dream haunting."
      ]
    },
    {
      "name": "Spell Ambush",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [],
      "entries": [
        "A creature flat-footed to the night hag takes a –2 circumstance penalty to checks and DCs to defend against her spells."
      ]
    }
