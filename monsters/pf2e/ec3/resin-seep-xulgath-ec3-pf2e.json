      "activity": null,
      "traits": [
        "incapacitation",
        "poison"
      ],
      "entries": [
        "A creature damaged by a resin-seep xulgath's jaws or claw Strike must succeed at a DC 28 Reflex save or be covered with clumps of noxious resin, taking 2d8 poison damage and a –15-foot penalty to its Speeds for 1 minute (on a critical failure, the creature is also clumsy|CRB|clumsy 1 for 1 minute). The creature is sickened|CRB|sickened 1 for as long it has a Speed penalty. A creature can spend an Interact action to scrape the resin off, decreasing the Speed penalty by 5 with each such action."
      ],
      "save": {
        "defense": "reflex",
        "dc": 28,
        "basic": false,
        "outcomes": {}
      },
