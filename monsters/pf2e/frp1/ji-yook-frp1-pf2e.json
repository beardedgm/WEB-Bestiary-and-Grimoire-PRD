      "entries": [
        "Ji-yook makes a fist Strike. On a hit, the target takes an additional 2d4 electricity damage and is pushed back 5 feet. On a critical hit, the target is pushed back and then knocked prone."
      ],
      "damage": [
        {
          "formula": "2d4",
