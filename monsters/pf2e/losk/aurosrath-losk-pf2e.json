  "entries": [
    {
      "name": "Smeltable",
      "category": "passive",
      "placement": "mid",
      "activity": null,
      "traits": [],
      "entries": [
        "If an aurosrath takes 5 or more fire damage from a single attack, the precious metals within their body enter a molten state until the end of their next turn. While in this state, the aurosrath takes a −10-foot status penalty to their Speeds, and their strikes deal an extra 1d6 fire damage. They also lose their weakness to slashing damage and their resistance to electricity damage. Finally, any creature currently grabbed|PC1 or restrained|PC1 by the aurosrath loses 1 round of air if it's holding its breath."
      ],
