    {
      "name": "Endless Suffering",
      "category": "passive",
      "placement": "mid",
      "activity": null,
      "traits": [],
      "entries": [
        "The type of torture that killed a tormented determines the effect of their Tortured Gaze, as listed below. The damage type listed in parentheses deactivates their regeneration and is their damage weakness. The most common tortured deaths are as follows."
      ]
    },
    {
      "name": "Burning",
      "category": "passive",
      "placement": "mid",
      "activity": null,
      "traits": [
        "fire"
      ],
      "entries": [
        "The tormented perished by fire and brand. The target takes 6d6 fire damage and is wreathed in ghostly flames for 1 minute, negating its concealed condition and rendering it concealed if it would be invisible."
      ],
      "damage": [
        {
          "formula": "6d6",
          "average": null,
          "type": "fire"
        }
      ]
    },
    {
      "name": "Crushing",
      "category": "passive",
      "placement": "mid",
      "activity": null,
      "traits": [
        "bludgeoning"
      ],
      "entries": [
        "The tormented was crushed or broken on the wheel. The target takes 4d8 bludgeoning damage and is knocked prone."
      ],
      "damage": [
        {
          "formula": "4d8",
          "average": null,
          "type": "bludgeoning"
        }
      ]
    },
    {
      "name": "Dislocation",
      "category": "passive",
      "placement": "mid",
      "activity": null,
      "traits": [
        "bludgeoning"
      ],
      "entries": [
        "The tormented had their limbs repeatedly broken or dislocated. For 1d4 rounds, the target is clumsy 2 and slowed 1."
      ]
    },
    {
      "name": "Drowning",
      "category": "passive",
      "placement": "mid",
      "activity": null,
      "traits": [
        "cold"
      ],
      "entries": [
        "The tormented was repeatedly drowned, held underwater and pulled back at the last instant. The target takes 4d6 cold damage and is sickened 2."
      ],
      "damage": [
        {
          "formula": "4d6",
          "average": null,
          "type": "cold"
        }
      ]
    },
    {
      "name": "Impalement",
      "category": "passive",
      "placement": "mid",
      "activity": null,
      "traits": [
        "piercing"
      ],
      "entries": [
        "The tormented was pierced with spears or blades and left to slowly die. The target takes 8d4 persistent bleed damage. (The creature doesn't take the persistent damage this turn, nor does it get its flat check to end the damage.)"
      ]
    },
    {
      "name": "Starvation",
      "category": "passive",
      "placement": "mid",
      "activity": null,
      "traits": [
        "cold"
      ],
      "entries": [
        "The tormented starved to death, denied food until the end. For 1 minute, the target is enfeebled 2 and fatigued."
      ]
    },
    {
      "name": "Tortured Gaze",
      "category": "passive",
      "placement": "mid",
      "activity": null,
      "traits": [
        "aura",
        "divine",
        "illusion",
        "mental"
      ],
      "entries": [
        "30 feet, or 60 feet if the tormented is at 125 HP or lower. The psychic agony of a tormented spills into the world around them, inflicting murderous hallucinations replicating the tormented's last moments. A non-undead creature that ends its turn in the aura must succeed at a DC 32 Will save or take the effect listed under Endless Suffering. While it has a condition from Tortured Gaze, a creature can't gain a new condition from the aura but can take damage from it again."
      ],
      "save": {
        "defense": "will",
        "dc": 32,
        "basic": false,
        "outcomes": {}
      },
      "aura": {
        "range": 30,
        "unit": "ft"
      }
