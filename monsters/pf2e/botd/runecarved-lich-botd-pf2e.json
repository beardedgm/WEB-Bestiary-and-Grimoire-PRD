    {
      "name": "Drain Spell Tome",
      "category": "free",
      "placement": "bot",
      "activity": {
        "unit": "free",
        "number": 1,
        "symbol": "◇"
      },
      "traits": [],
      "entries": [
        "The lich draws upon the magic stored in their spell tome to cast one of the spells they've countered. This spell is the same level as the one countered, but it uses the runecarved lich's spell DC and spell attack. Casting a spell in this way removes it from the spell tome."
      ]
    },
