      "entries": [
        "30 feet. A living creature that enters the area must succeed at a DC 31 Will save or gain the doomed 1 condition. A critical failure increases this condition to doomed 2. Regardless of the result of the saving throw, the creature is temporarily immune to this death coach's aura of doom for 1 minute."
      ],
      "save": {
        "defense": "will",
        "dc": 31,
        "basic": false,
        "outcomes": {}
      },
      "aura": {
        "range": 30,
        "unit": "ft"
