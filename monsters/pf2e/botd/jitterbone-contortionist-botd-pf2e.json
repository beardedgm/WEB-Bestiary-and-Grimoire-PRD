    {
      "name": "Compression",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [],
      "entries": [
        "The jitterbone can move through a gap at least 6 inches wide without Squeezing and can Squeeze through a gap at least 2 inches wide. When the jitterbone successfully Squeezes, they move through the tight space at full Speed. Narrow confines aren't terrain for a jitterbone."
      ]
    },
    {
      "name": "Death Gasp",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [
        "divine",
        "necromancy"
      ],
      "entries": [
        "As shadern immolator, except up to 8 rounds."
      ]
    },
    {
      "name": "Osseous Defense",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [
        "divine",
        "transmutation"
      ],
      "entries": [
        "The jitterbone elongates their bones, causing jagged bone spikes to protrude from their skin. While Osseous Defense is active, the jitterbone can make bone spike and bone dart Strikes (see below) and gains resistance 5 to piercing damage and slashing damage. The jitterbone loses Compression while their Osseous Defense is active. The jitterbone can end Osseous Defense as a single action, retracting their bones back into their body."
      ]
    }
