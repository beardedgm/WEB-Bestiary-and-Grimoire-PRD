      "traits": [],
      "entries": [
        "The sluagh reaper becomes incorporeal until the start of their next turn, and Flies up to their fly Speed. While incorporeal, they are immune to precision damage, and have resistance 10 to all damage (except force, ghost touch, or positive); this resistance is doubled against non-magical damage. After using Ghostly Swoop, the sluagh reaper can't use it again for 1d4 rounds."
      ],
      "recharge": {
        "kind": "dice",
        "formula": "1d4",
        "unit": "rounds"
      }
    },
