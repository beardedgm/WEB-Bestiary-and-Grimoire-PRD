        "symbol": "◆◆"
      },
      "traits": [],
      "entries": [
        "The quoppopak uses Tentacle Stab against a creature within reach; if either of these Strikes hits, the creature must attempt a DC 30 Reflex save. On a failed save, the quoppopak shoots water through its tentacles into the creature, dealing 2d6+5 bludgeoning damage and making the creature sickened 1 as its internal organs fill with water (double damage and sickened 2 on a critical failure)."
      ],
      "requirements": "The quoppopak's ventral tube is in water",
      "save": {
        "defense": "reflex",
        "dc": 30,
        "basic": false,
        "outcomes": {}
      }
    },
    {
      "name": "Tentacle Stab",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [],
      "entries": [
        "The quoppopak makes two tentacle Strikes against the same creature. These Strikes deal piercing damage instead of bludgeoning, and the quoppopak can't Grab with them. Its multiple attack penalty doesn't increase until after both attacks."
      ],
      "frequency": {
        "number": 1,
        "unit": "round",
        "text": null
      }
    },
    {
      "name": "Water Glide",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [],
      "entries": [
        "The quoppopak can stand and move on the surface of water or other liquids without falling through. It can go underwater if it wishes, but it must Swim to do so."
      ]
    }
