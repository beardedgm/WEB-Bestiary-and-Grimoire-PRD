      "name": "Hair Snare",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [
        "incapacitation",
        "primal",
        "transmutation"
      ],
      "entries": [
        "The korred causes a long, tangled length of their hair to detach from their body and snake out to coil around an adjacent creature. The creature must attempt a DC 21 Reflex save. The korred cannot use Hair Snare again for 1d4 rounds."
      ],
      "save": {
        "defense": "reflex",
        "dc": 21,
        "basic": false,
        "outcomes": {
          "success": "The creature is unaffected.",
          "failure": "The hair wraps around the creature. The creature takes a –10-foot circumstance penalty to all of its Speeds until it Escapes (DC 21) or until the korred uses Hair Snare again (at which point the previous snare drops to the ground, no longer animated).",
          "criticalFailure": "The creature is immobilized until it Escapes (DC 21) or the korred uses Hair Snare again."
        }
      }
    },
    {
      "name": "Otherworldly Laugh",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 2,
        "symbol": "◆◆"
      },
      "traits": [
