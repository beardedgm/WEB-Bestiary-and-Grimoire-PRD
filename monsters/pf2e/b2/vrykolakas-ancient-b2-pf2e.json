        "manipulate"
      ],
      "entries": [
        "The vrykolakas ancient steals the creature's breath. The unconscious creature begins suffocating, can't be awakened for 1 round, and must attempt a DC 33 Fortitude save. If a creature is targeted with this ability in consecutive rounds, the save DC decreases by 2 each round after the first."
      ],
      "requirements": "The vrykolakas ancient is adjacent to an unconscious creature",
      "save": {
