        "enchantment",
        "linguistic",
        "mental"
      ],
      "entries": [
        "The trumpet archon offers an ally praise or encouragement. The archon attempts to counteract one emotion effect on the ally (with a counteract modifier of +24), and the archon and the ally both gain a +1 status bonus to attack rolls and saving throws for 1 round."
      ]
    },
    {
      "name": "Trumpet Blast",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [
        "auditory",
        "divine",
        "emotion",
        "enchantment",
        "mental"
      ],
      "entries": [
        "The trumpet archon blows mightily on their horn, creating a tone of such beauty and grandeur those who hear it are paralyzed in awe. Non-archons within 100 feet must attempt a DC 34 Fortitude save. They are temporarily immune for 10 minutes."
      ],
