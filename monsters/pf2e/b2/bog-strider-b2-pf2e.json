    {
      "name": "Hurl Net",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [],
      "entries": [
        "The bog strider hurls their net to hamper a foe. They make a ranged Strike (with a +10 modifier) against a Medium or smaller creature within 20 feet. On a hit, the target is flat-footed and takes a –10-foot circumstance penalty to its Speeds. On a critical hit, the creature is instead restrained. The DC to Escape the net is 16. A creature adjacent to the target can Interact with the net to remove it from the target."
      ],
      "requirements": "The bog strider is holding a net in two hands"
    },
    {
      "name": "Water Sprint",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 3,
        "symbol": "◆◆◆"
      },
      "traits": [],
      "entries": [
        "The bog strider Strides up to three times in a straight line across smooth water. They can make a single Strike against a creature at the end of this movement."
      ]
    },
    {
      "name": "Water Stride",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [],
      "entries": [
        "The bog strider can stand and move on the surface of water or other liquids without falling through. The bog strider can go underwater if they wish, but they must Swim to do so."
      ]
    }
