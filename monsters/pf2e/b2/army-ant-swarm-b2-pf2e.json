      "traits": [],
      "entries": [
        "The swarm takes 1d6 damage as ants cling to the creature and continue biting, dealing 3d6 persistent piercing damage. High winds or immersion in water reduces the DC of the flat check to end this persistent damage to 5. Any area damage dealt to the creature destroys these clinging ants."
      ],
      "trigger": "A creature leaves the swarm's space"
    },
    {
