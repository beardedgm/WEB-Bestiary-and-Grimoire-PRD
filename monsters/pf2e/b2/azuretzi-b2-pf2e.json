  "entries": [
    {
      "name": "Protean Anatomy",
      "category": "passive",
      "placement": "mid",
      "activity": null,
      "traits": [
        "divine",
        "transmutation"
      ],
      "entries": [
        "An azuretzi's vital organs shift and change shape and position constantly. Immediately after the azuretzi takes acid, electricity, or sonic damage, it gains the listed amount of resistance to that damage type. This lasts for 1 hour or until the next time the protean takes damage of one of the other types (in which case its resistance changes to match that type), whichever comes first. The azuretzi is immune to polymorph effects unless it is a willing target. If blinded or deafened, the akizendri automatically recovers at the end of its next turn as new sensory organs grow to replace the compromised ones."
      ]
    },
    {
      "name": "Spell Pilfer",
      "category": "reaction",
      "placement": "mid",
      "activity": {
        "unit": "reaction",
        "number": 1,
        "symbol": "◈"
      },
      "traits": [],
      "entries": [
        "The azuretzi attempts to counteract one ongoing spell effect on the target creature with a Thievery check. If it is successful, it transfers the ongoing spell effect to itself. The creature then becomes temporarily immune to Spell Pilfer for 24 hours."
      ],
      "trigger": "A creature with an active spell effect within 30 feet of the azuretzi fails to resist another azuretzi's Mocking Touch"
