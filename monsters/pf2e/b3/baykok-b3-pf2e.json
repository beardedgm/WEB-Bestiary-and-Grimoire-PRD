      "entries": [
        "A baykok creates an invisible arrow of bone as it draws its bow. A frightened creature hit by the arrow is stricken with loneliness and despair and must attempt a DC 26 Will save; if the Strike was a critical hit, the target uses the outcome one degree of success worse than the result of its save."
      ],
      "save": {
        "defense": "will",
        "dc": 26,
        "basic": false,
        "outcomes": {
          "criticalSuccess": "The creature is unaffected.",
          "success": "The creature is slowed 1 for 1 round.",
          "failure": "The creature's frightened value increases by 1 (to a maximum of 4), and it is slowed 1 until its frightened condition ends.",
          "criticalFailure": "As failure, but the creature is paralyzed until its frightened condition ends. At the start of each of its turns, it can end the paralyzed condition early with a successful DC 26 Will save."
        }
      }
    },
    {
      "name": "Devour Life",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [
        "curse",
        "necromancy",
        "occult"
      ],
      "entries": [
        "The baykok touches the target and devours part of its life force. The target must succeed at a DC 26 Fortitude save or be afflicted with the baykok's wasting curse. If the target fails and wasn't already affected by the wasting curse, the baykok gains 20 temporary Hit Points that last for 1 hour."
      ],
      "requirements": "The baykok is adjacent to a paralyzed, restrained, or unconscious living humanoid",
      "save": {
        "defense": "fortitude",
        "dc": 26,
        "basic": false,
        "outcomes": {}
      }
    },
    {
      "name": "Wasting Curse",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [
        "curse",
        "necromancy",
        "occult"
      ],
      "entries": [
        "The baykok steals life from its victim and leaves listless dread in its place. If a target fails its save against Devour Life, it becomes drained 1. Each time the target gets a full night's rest, it must succeed at a DC 26 Fortitude save or its drained value increases rather than decreasing. The curse ends if the creature recovers from the drained condition, but if the creature would reach drained 5 from this effect, it dies."
      ],
      "save": {
        "defense": "fortitude",
        "dc": 26,
        "basic": false,
        "outcomes": {}
      }
