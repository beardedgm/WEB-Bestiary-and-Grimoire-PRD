      ],
      "entries": [
        "Using their voice imitation abilities, a kokogiak emits the horrific wails of its former victims. Each creature within 120 feet takes 4d6 mental damage and must attempt a DC 32 Will save. A creature frightened by this ability is flat-footed to the kokogiak."
      ],
      "save": {
        "defense": "will",
        "dc": 32,
        "basic": false,
        "outcomes": {
