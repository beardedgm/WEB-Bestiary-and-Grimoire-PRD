    {
      "name": "Frightening Rant",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [
        "auditory",
        "concentrate",
        "emotion",
        "enchantment",
        "fear",
        "linguistic",
        "mental",
        "occult"
      ],
      "entries": [
        "The skelm rants angrily, filling nearby creatures with shame, fear, and anger. Each creature within 30 feet must succeed at a DC 20 Will save or become frightened 1 (frightened 2 on a critical failure). While frightened by this rant, creatures take a –2 status penalty to Strength-based damage rolls against the skelm, but gain a +2 status bonus to those rolls against other creatures."
      ],
      "save": {
        "defense": "will",
        "dc": 20,
        "basic": false,
        "outcomes": {}
      }
    },
    {
      "name": "Punishing Strike",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [],
      "entries": [
        "The skelm unleashes his constant rage in a reckless attack that makes him flat-footed until the start of his next turn. He Strikes; if he hits, he increases the number of damage dice by one and adds Push to the effect. This counts as two attacks for his multiple attack penalty."
      ]
    }
