      ],
      "entries": [
        "The angheuvore draws in a deep breath and holds it, temporarily suspending their biological processes and becoming undead. The angheuvore gains the undead trait and becomes immune to bleed, death effects, disease, paralyzed, poison, and sleep. Any such effects the angheuvore is currently suffering from are suspended, but take effect again once they take a breath."
      ]
    },
    {
      "name": "Death",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [],
      "entries": [
        "Gasp lasts as long as the angheuvore holds their breath (up to 8 rounds, Core Rulebook 478)."
      ]
    },
    {
      "name": "Invigorating Feast",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [
        "manipulate"
      ],
      "entries": [
        "The angheuvore feasts upon the creature, dealing their jaws Strike damage (basic Fortitude save); a corpse automatically critically fails with no save. If the target takes damage, the angheuvore gains 5 temporary Hit Points and a +10-foot circumstance bonus to their Speeds for 1 minute."
      ],
      "requirements": "The angheuvore is adjacent to a paralyzed, restrained, or unconscious creature, or a deceased creature that died in the last hour"
    },
    {
      "name": "Paralysis",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [
        "divine",
        "incapacitation",
        "necromancy"
      ],
      "entries": [
        "Any living creature hit by an angheuvore's jaws Strike must succeed at a DC 15 Fortitude save or become paralyzed. It can attempt a new save to end the condition at the end of each of its turns, and the DC cumulatively decreases by 1 on each save."
      ],
