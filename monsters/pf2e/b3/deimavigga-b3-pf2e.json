      "entries": [
        "The deimavigga whispers disturbing lies, audible only to the target, to shake the target's faith in the spell's caster. The target must attempt a DC 43 Will save."
      ],
      "trigger": "A creature within 60 feet is targeted by a spell that would restore Hit Points or provide a status bonus (the deimavigga automatically recognizes such effects)",
      "save": {
        "defense": "will",
        "dc": 43,
        "basic": false,
        "outcomes": {
          "criticalSuccess": "The target disbelieves the lies and receives the intended benefit of the spell; the target becomes temporarily immune to Whispers of Discord for 24 hours.",
