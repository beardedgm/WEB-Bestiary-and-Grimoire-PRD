    {
      "name": "Master of",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [],
      "entries": [
        "Barriers Laruhao wishes for nothing more than to dance atop his yagura, undisturbed. When he uses his house of imaginary walls composition spell, he creates four 10-foot-by-10-foot walls in a cube around him. A creature must succeed at a DC 41 counteract check to teleport within these walls; otherwise, the teleportation attempt fails."
      ]
    }
