      "name": "Powerful",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [],
      "entries": [
        "Fists Usilket's fist Strikes are treated as cold iron and silver and don't take penalties when making lethal attacks."
      ]
