        "number": 3,
        "symbol": "◆◆◆"
      },
      "traits": [
        "attack",
        "manipulate"
      ],
      "entries": [
        "Requirements The enforcer has manacles in hand and is adjacent to a creature; The enforcer attempts to bind the creature's wrists or ankles with the manacles. If the enforcer succeeds at an attack roll with a +30 modifier against the target's AC, they apply the manacles."
      ]
    }
