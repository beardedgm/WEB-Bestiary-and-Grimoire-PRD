      "traits": [],
      "entries": [
        "The clockwork brewer forcefeeds the grappled creature 1 serving of whatever liquid is in the clockwork brewer's tank (typically beer such as Smokeside Sour; see sidebar). The creature is exposed to the liquid's effects, and it can't breathe or speak until the start of its turn."
      ],
      "requirements": "The clockwork brewer has a creature grappled"
    },
