    {
      "name": "Inferno Leap",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 2,
        "symbol": "◆◆"
      },
      "traits": [
        "fire"
      ],
      "entries": [
        "The elemental inferno jumps horizontally and vertically with a maximum height and distance each equal to its Speed. Its intense heat is suppressed until the end of the jump. At any point during the jump, flames explode from the elemental in a 30-foot emanation, dealing 12d6 fire damage to each creature within the area (DC 30 basic Reflex save). The elemental inferno can't Inferno Leap again for 1d4 rounds."
      ],
