    {
      "name": "Pin Prey",
      "category": "reaction",
      "placement": "bot",
      "activity": {
        "unit": "reaction",
        "number": 1,
        "symbol": "◈"
      },
      "traits": [],
      "entries": [
        "The creature struck by the foot is knocked prone and the tyrannosaurus uses its foot to hold the creature in place. As long as the tyrannosaurus doesn't move from its position, the pinned creature is Grabbed. A tyrannosaurus gains a +2 circumstance bonus to attack a creature it has pinned in this manner, but it cannot use Swallow Whole on the target unless it uses its jaws to Grab the victim first."
      ],
      "trigger": "The tyrannosaurus critically hits a Large or smaller foe with its foot."
    },
