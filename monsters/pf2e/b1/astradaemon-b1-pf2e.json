    {
      "name": "Essence Drain",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [
        "divine",
        "necromancy",
        "negative"
      ],
      "entries": [
        "When an astradaemon hits with its claw, jaws, or tail, it drains the target's spiritual and vital essences. The target takes 2d10 negative energy damage and the astradaemon regains an equal number of Hit Points. The target must succeed at a DC 37 Fortitude save or become doomed 1 and drained 1. If the target was already drained or doomed, it instead increases both conditions' value by 1, to a maximum of 4."
      ],
      "save": {
