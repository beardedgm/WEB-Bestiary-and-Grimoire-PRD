      "entries": [
        "The boggard scout unleashes a terrifying croak. Any non-boggard within 30 feet becomes frightened 1 unless they succeed at a DC 17 Will save; those who critically succeed are temporarily immune for 1 minute."
      ],
      "save": {
        "defense": "will",
