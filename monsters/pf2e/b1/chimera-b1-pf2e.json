      "traits": [
        "arcane",
        "evocation"
      ],
      "entries": [
        "The chimera breathes a cone or line that deals 9d6 damage to all creatures in the area (DC 26 basic save of a type indicated below). The color of the chimera's dragon head determines the area of the Breath Weapon, the type of damage it deals, and the type of save to avoid it. The chimera can't use Breath Weapon again for 1d4 rounds. - Black 60-foot line of acid (Reflex)",
        "- Blue 60-foot line of electricity (Reflex)",
        "- Green 30-foot cone of poison (Fortitude)",
        "- Red 30-foot cone of fire (Reflex)",
        "- White 30-foot cone of cold (Reflex)"
      ],
      "area": {
        "shape": "line",
        "size": 60,
        "unit": "ft"
      },
      "recharge": {
        "kind": "dice",
        "formula": "1d4",
        "unit": "rounds"
      }
