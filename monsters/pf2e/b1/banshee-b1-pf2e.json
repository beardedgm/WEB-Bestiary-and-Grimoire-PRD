    {
      "name": "Wail",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 2,
        "symbol": "◆◆"
      },
      "traits": [
        "auditory",
        "concentrate",
        "death",
        "necromancy",
        "occult"
      ],
      "entries": [
        "The banshee unleashes a soul-chilling wail of the banshee (DC 38). This Wail overcomes silence and similar effects of 5th level or lower. The banshee can instead use Wail as a three-action activity to overcome such effects of up to 8th level. The banshee's Wail resonates for 1 round, and any creature that comes within the area during that time must attempt a save against the effect. A creature can't be affected more than once by the same Wail. The banshee can't Wail again for 1d4 rounds."
      ]
    }
