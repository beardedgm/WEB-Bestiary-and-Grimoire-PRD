    {
      "name": "Corpse Throwing",
      "category": "passive",
      "placement": "bot",
      "activity": null,
      "traits": [],
      "entries": [
        "A zombie hulk can throw corpses at foes. While any Medium dead body will do, they sometimes throw zombie shambler|b1|zombie shamblers, who take just as much damage from being thrown as the target they hit. A thrown shambler lands prone, but if it's not destroyed, it can rise and use other actions normally."
      ]
    },
    {
      "name": "Wide Swing",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [],
      "entries": [
        "The zombie hulk makes a hunk of meat Strike and compares the attack roll result to the AC of up to two foes, each of whom must be within the Strike's reach. This attack counts as two attacks for the zombie hulk's multiple attack penalty."
      ]
    }
