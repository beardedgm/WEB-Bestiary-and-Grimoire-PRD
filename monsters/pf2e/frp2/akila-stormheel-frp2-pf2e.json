      },
      "traits": [],
      "entries": [
        "Akila Strides, then Strikes. If she was hidden at the start of this action, she remains hidden until after the Strike."
      ]
    },
    {
      "name": "Powerful Leap",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 2,
        "symbol": "◆◆"
      },
      "traits": [],
      "entries": [
        "Akila Leaps either up to 50 feet horizontally and 10 feet vertically or up to 25 feet vertically and up to 10 feet horizontally. She can make a Strike at any point during the Leap. If she hits, she deals an extra 8 bludgeoning damage from the impact."
      ]
