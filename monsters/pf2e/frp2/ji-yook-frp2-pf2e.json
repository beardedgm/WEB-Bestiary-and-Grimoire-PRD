      "entries": [
        "Ji-yook makes a fist Strike. On a hit the target takes an additional 3d4 electricity damage and is pushed back 10 feet. On a critical hit, the target is pushed back and then knocked prone."
      ],
      "damage": [
        {
          "formula": "3d4",
