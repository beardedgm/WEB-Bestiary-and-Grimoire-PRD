    {
      "name": "Share the Skin",
      "category": "action",
      "placement": "bot",
      "activity": {
        "unit": "action",
        "number": 1,
        "symbol": "◆"
      },
      "traits": [],
      "entries": [
        "The skinskitter scrapes and shears away large sheets of the victim's skin. This requires an Athletics check against the victim's Fortitude DC if the victim is grabbed and is automatic for any of the other conditions. The massive pain causes the victim to become clumsy 1 for 1 minute, and the skinskitter drapes itself in the flapping skin, granting it 10 temporary Hit Points for 1 minute."
      ],
      "requirements": "A grabbed, paralyzed, restrained, unconscious, or willing creature is within the skinskitter's reach"
