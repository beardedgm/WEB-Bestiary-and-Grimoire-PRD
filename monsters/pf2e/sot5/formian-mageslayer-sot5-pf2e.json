      "category": "passive",
      "placement": "mid",
      "activity": null,
      "traits": [],
      "entries": [
        "A formian mageslayer takes 15 fewer damage from any arcane or primal spell that causes damage, and 10 less damage from any divine or occult spell that causes damage."
      ]
